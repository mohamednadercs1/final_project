# Copy this file to .env and fill in your keys (no quotes, no spaces around =)
# TMDB: use EITHER the v3 API key OR the v4 read access token (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_v3_api_key
# TMDB_READ_TOKEN=your_tmdb_v4_read_access_token
# OMDb (activate the key via the emailed link): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_key
